{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kimkim-uz",
  "main": "worker-scheduled.mjs",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "kimkim.uz/*", "zone_name": "kimkim.uz" },
    { "pattern": "www.kimkim.uz/*", "zone_name": "kimkim.uz" }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://kimkim.uz",
    "NEXT_PUBLIC_TELEGRAM_BOT_USERNAME": "kimkimuzbot"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kimkim-uz"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kimkim-db",
      "database_id": "fc042b1a-b261-42cd-840d-0f5698ef60ad"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kimkim-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
