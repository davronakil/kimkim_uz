# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js / OpenNext
/.next/
/.open-next/
/out/
/build
/dist
.turbo

# Cloudflare local state (D1 sqlite, caches, etc.)
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# secrets & local env (never commit real credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
.credentials
.credentials.json
secrets/
*.secret

# local databases / dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel (unused; Workers deploy)
.vercel
